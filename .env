# Postgres
POSTGRES_USER=medfastuser
POSTGRES_PASSWORD=medfastpassword
POSTGRES_DB=medfastdb
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/medfastdb

# Mail (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=medfast.noreply@gmail.com
MAIL_PASSWORD=${MAIL_PASSWORD}
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
EMAIL_VERIFICATION_TTL_MS=3600000
EMAIL_VERIFICATION_VERIFY_URL=https://medfast.com/api/auth/verify?token=

# JWT
JWT_SECRET=${JWT_SECRET}

# Grafana
GF_ADMIN_PASSWORD=admin
