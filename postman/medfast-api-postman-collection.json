    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login - Valid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time is acceptable (< 400ms)\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(400);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response structure contains data object\", function () {\r",
                  "    pm.expect(jsonData).to.have.property(\"data\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"AccessToken is present and valid\", function () {\r",
                  "    pm.expect(jsonData.data.accessToken).to.be.a(\"string\").and.not.be.empty;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"RefreshToken is present and valid\", function () {\r",
                  "    pm.expect(jsonData.data.refreshToken).to.be.a(\"string\").and.not.be.empty;\r",
                  "});\r",
                  "\r",
                  "if (pm.response.code === 200 && jsonData.data) {\r",
                  "    pm.environment.set(\"adminAccessToken\", jsonData.data.accessToken);    \r",
                  "    pm.environment.set(\"adminRefreshToken\", jsonData.data.refreshToken);\r",
                  "    console.log(\"Login successful. Tokens saved to Environment.\");\r",
                  "    console.log(pm.environment.get(\"adminRefreshToken\"));\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\": \"{{adminEmail}}\",\r\n    \"password\": \"{{adminPassword}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/auth/login",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login - Invalid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code is 401\", function () {\r",
                  "    pm.response.to.have.status(401);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Content-Type is JSON\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response data is null\", function () {\r",
                  "    pm.expect(jsonData.data).to.be.null;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Error code is AUTH_ERROR\", function () {\r",
                  "    pm.expect(jsonData.error).to.have.property(\"errorCode\", \"AUTH_ERROR\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Error message says 'Invalid email or password'\", function () {\r",
                  "    pm.expect(jsonData.error).to.have.property(\"message\", \"Invalid email or password\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
